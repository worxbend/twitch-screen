# FreeCAD / Blender autosave and backups
*.FCStd1
*.FCBak
*.blend[0-9]*

# Build logs and scratch work (not reproducible inputs, not deliverables)
logs/
scratch/

# Release bundle, regenerated by scripts/package_project.py
TwitchScreen-deliverables.zip

