# SPDX-License-Identifier: MIT
# Credential-free, non-Twitch loopback deployment. This file contains no secrets.
# Run: python3 tools/compose.py --env-file .env.example up --build -d
# Existing persisted desired settings take precedence over these startup defaults.
RELAY_TWITCH_MODE=disabled
RELAY_TWITCH_CHANNEL=
RELAY_CHAT_NOTIFICATIONS=hide
RELAY_BIND_IP=127.0.0.1
RELAY_PUBLISHED_HTTP_PORT=8080
RELAY_PUBLISHED_DEVICE_PORT=8099
RELAY_HTTP_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,[::1]:8080
RELAY_HTTP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080
# Physical devices require an explicitly selected trusted LAN/VPN address,
# matching exact HTTP Host/Origin entries and firewall rules. Never publish
# management or plain device TCP on the internet. See docs/guides/relay-setup.md.
# Keep provider secrets in a separate private env file. Never add management
# AUTH settings: they are obsolete and nonempty values prevent startup.
#
# Live Twitch setup: copy to .env (gitignored, chmod 600), then replace the
# startup values above and uncomment the provider values below. Keep real
# credentials only in .env, never in this template or firmware credentials.h.
# Valid modes are disabled, simulated and live; "enabled" is not a mode.
# RELAY_TWITCH_MODE=live
# RELAY_TWITCH_CHANNEL=yourchannel
# RELAY_CHAT_NOTIFICATIONS=show
# RELAY_TWITCH_CLIENT_ID=replace-with-your-app-client-id
# RELAY_TWITCH_CLIENT_SECRET=replace-with-your-app-client-secret
# RELAY_TWITCH_REDIRECT_URL=http://localhost:8080/api/v1/twitch/callback
# This exact redirect must be registered in the Twitch developer console.
# App credentials do not replace the broadcaster's OAuth/MFA consent.
# Preserve the relay-data volume: it holds the granted token and runtime intent.
#
# Optional Compose-supported deployment settings (defaults shown):
# RELAY_RUNTIME_STATE_FILE=/home/relay/data/runtime-state.json
# RELAY_HTTP_PUBLIC_ORIGIN=
# RELAY_HTTP_TRUSTED_PROXIES=
# Only set public origin/trusted proxies for a verified HTTPS reverse proxy.
#
# Optional built-in Open-Meteo weather. Disabled in this safe template.
# Set true in your private .env to fetch Kyiv weather on the relay.
# Free endpoint: non-commercial use only; see docs/guides/weather.md.
RELAY_WEATHER_ENABLED=false
RELAY_WEATHER_LATITUDE=50.45466
RELAY_WEATHER_LONGITUDE=30.5238
RELAY_WEATHER_LOCATION=Kyiv
RELAY_WEATHER_UNIT=celsius
RELAY_WEATHER_REFRESH_INTERVAL="5 minutes"
RELAY_WEATHER_FRESHNESS="15 minutes"
RELAY_WEATHER_REQUEST_TIMEOUT="10 seconds"
