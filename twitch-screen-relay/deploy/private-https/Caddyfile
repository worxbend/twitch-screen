{
	admin off
	auto_https disable_redirects
	skip_install_trust
	servers {
		strict_sni_host on
	}
}

https://{$RELAY_PRIVATE_HOST} {
	bind {$CADDY_BIND_IP}
	tls internal
	reverse_proxy {$RELAY_PROXY_UPSTREAM:127.0.0.1:8080} {
		flush_interval -1
		header_up -Forwarded
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Port
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}
