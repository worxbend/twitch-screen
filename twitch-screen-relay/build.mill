//| mill-version: 1.1.9
//| mill-jvm-version: temurin:25
package build

import mill.*, scalalib.*

object Versions {
  val scala = "3.9.0"

  /** Toolchain for compiling, running and testing. Ox needs virtual threads (21+); 25 is the current LTS. */
  val jvm = "temurin:25"

  val ox = "1.0.8"
  val tapir = "1.13.31"
  val jsoniter = "2.41.0"
  val pureconfig = "0.17.10"
  val macwire = "2.6.7"
  val twitch4j = "1.27.0"
  val otel = "1.66.0"

  /** The OpenTelemetry instrumentation artifacts are only ever published as `-alpha`; this is their latest release. */
  val otelInstrumentation = "2.9.0-alpha"

  val logback = "1.6.4"
  val munit = "1.3.6"
}

object `package` extends ScalaModule {
  def scalaVersion = Versions.scala
  def jvmId = Versions.jvm

  def scalacOptions = Seq(
    "-Werror",
    "-deprecation",
    "-feature",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement"
  )

  def mvnDeps = Seq(
    // Structured concurrency on virtual threads.
    mvn"com.softwaremill.ox::core:${Versions.ox}",
    mvn"com.softwaremill.ox::otel-context:${Versions.ox}",
    mvn"com.softwaremill.ox::mdc-logback:${Versions.ox}",
    // HTTP management API.
    mvn"com.softwaremill.sttp.tapir::tapir-netty-server-sync:${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-jsoniter-scala:${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-swagger-ui-bundle:${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-opentelemetry-metrics:${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-opentelemetry-tracing:${Versions.tapir}",
    // JSON for HTTP responses, Twitch OAuth and EventSub bodies. The device protocol is binary TSB/3.
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros:${Versions.jsoniter}",
    // Typed HOCON configuration.
    mvn"com.github.pureconfig::pureconfig-core:${Versions.pureconfig}",
    // Twitch. The aggregate brings helix (REST), chat (IRC), eventsub-common, eventsub-websocket and pubsub, plus
    // the TwitchClientBuilder that wires them together.
    mvn"com.github.twitch4j:twitch4j:${Versions.twitch4j}",
    // Observability.
    mvn"io.opentelemetry:opentelemetry-sdk-extension-autoconfigure:${Versions.otel}",
    mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otel}",
    mvn"io.opentelemetry:opentelemetry-exporter-sender-jdk:${Versions.otel}",
    // The runtime-telemetry instrumentation builds its counters through the incubator API, which the SDK does not
    // pull in on its own; without it RuntimeMetrics.create fails with NoClassDefFoundError at startup.
    mvn"io.opentelemetry:opentelemetry-api-incubator:${Versions.otel}-alpha",
    mvn"io.opentelemetry.instrumentation:opentelemetry-runtime-telemetry-java17:${Versions.otelInstrumentation}",
    mvn"io.opentelemetry.instrumentation:opentelemetry-logback-appender-1.0:${Versions.otelInstrumentation}",
    mvn"ch.qos.logback:logback-classic:${Versions.logback}"
  )

  /** MacWire is a compile-time macro: it wires the graph during compilation and leaves nothing on the runtime classpath. */
  def compileMvnDeps = Seq(
    mvn"com.softwaremill.macwire::macros:${Versions.macwire}"
  )

  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:${Versions.munit}",
      mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server:${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-sttp-client4:${Versions.tapir}"
    )
  }
}
