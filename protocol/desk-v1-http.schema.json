          "type": "string",
          "pattern": "^[0-9]{1,32}$"
        },
        "login": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,25}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-nonblank": true
