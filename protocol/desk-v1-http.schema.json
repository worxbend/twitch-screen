            {
              "type": "null"
            }
          ]
        },
        "remainingFreshnessMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800000
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/WeatherData"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "relayEpoch",
        "revision",
        "status",
        "reason",
        "receivedAt",
        "observedAtSource",
        "remainingFreshnessMs",
        "data"
      ],
      "additionalProperties": false
    },
