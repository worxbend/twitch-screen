        "revision",
        "status",
        "reason",
        "receivedAt",
        "observedAtSource",
        "remainingFreshnessMs",
        "data"
      ],
      "additionalProperties": false
    },
    "MonitorSetting": {
      "type": "object",
      "properties": {
